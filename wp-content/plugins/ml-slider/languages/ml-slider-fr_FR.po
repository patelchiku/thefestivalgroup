msgstr "Recadrage de l’image"

#: admin/views/pages/parts/slider-settings.php:1075
msgid "Smart Crop"
msgstr "Recadrage intelligent"

#: admin/views/pages/parts/slider-settings.php:1082, fuzzy
msgid "Standard"
msgstr "Standard"

