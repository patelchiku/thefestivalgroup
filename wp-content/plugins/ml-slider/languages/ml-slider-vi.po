#: themes/simply-dark/customize.php:795
msgid "Play / Pause Button"
msgstr "Nút Phát / Tạm Dừng"

#: admin/views/pages/parts/slider-settings.php:1221
msgid "This allows user to pause or resume Auto Play on the slideshow."
msgstr ""
"Điều này cho phép người dùng tạm dừng hoặc tiếp tục Phát Tự Động trên "
"slideshow."

#: admin/views/pages/parts/slider-settings.php:1229
msgid "Show Play / Pause Button Text"
msgstr "Hiển thị văn bản Nút Phát / Tạm Dừng"

#: admin/views/pages/parts/slider-settings.php:1234
msgid "Show text options for Play / Pause Button"
msgstr "Hiển thị tùy chọn văn bản cho Nút Phát / Tạm Dừng"

#: admin/views/pages/parts/slider-settings.php:1242
msgid "Play Text"
msgstr "Văn bản Phát"

#: admin/views/pages/parts/slider-settings.php:1244
#: admin/views/pages/parts/slider-settings.php:1257
msgid ""
"Enter text for the Play/Pause Button. Leave the field empty to use the icon "
"only."
msgstr ""
"Nhập văn bản cho Nút Phát/Tạm Dừng. Để trống trường này để chỉ sử dụng biểu "
"tượng."

#: admin/views/pages/parts/slider-settings.php:1255
msgid "Pause Text"
msgstr "Văn bản Tạm Dừng"

#: admin/views/pages/parts/slider-settings.php:1268
#: themes/customize.php:38
msgid "Progress Bar"
msgstr "Thanh Tiến Trình"

#: admin/views/pages/parts/slider-settings.php:1273
msgid "Displays a visual indicator showing the time left before the next slide."
msgstr ""
"Hiển thị một chỉ báo trực quan cho biết thời gian còn lại trước slide tiếp "
"theo."

#: admin/views/pages/parts/slider-settings.php:1281
msgid "Hover Pause"
msgstr "Tạm Dừng Khi Di Chuột"

#: admin/views/pages/parts/slider-settings.php:1286
msgid ""
"Pause the slideshow when hovering over slider, then resume when no longer "
"hovering."
msgstr ""
"Tạm dừng slideshow khi di chuột qua slider, sau đó tiếp tục khi không còn "
"di chuột."

#: admin/views/pages/parts/slider-settings.php:1294
msgid "Loop"
msgstr "Lặp Lại"

#: admin/views/pages/parts/slider-settings.php:1296
msgid ""
"If you choose \"Loop endlessly\", the slides will loop infinitely. If you "
"choose \"Stop on first slide after looping\", the slideshow will stop on "
"the first slide after showing all the items. If you choose \"Stop on last "
"slide\", the slides will stop on the last slide."
msgstr ""
"Nếu bạn chọn \"Lặp lại vô hạn\", các slide sẽ lặp lại vô hạn. Nếu bạn chọn "
"\"Dừng ở slide đầu tiên sau khi lặp lại\", slideshow sẽ dừng ở slide đầu "
"tiên sau khi hiển thị tất cả các mục. Nếu bạn chọn \"Dừng ở slide cuối "
"cùng\", các slide sẽ dừng ở slide cuối cùng."

#: admin/views/pages/parts/slider-settings.php:1299
msgid "Loop Endlessly"
msgstr "Lặp Lại Vô Hạn"

#: admin/views/pages/parts/slider-settings.php:1300
msgid "Stop On Last Slide"
msgstr "Dừng Ở Slide Cuối Cùng"

#: admin/views/pages/parts/slider-settings.php:1301
msgid "Stop On First Slide After Looping"
msgstr "Dừng Ở Slide Đầu Tiên Sau Khi Lặp Lại"

#: admin/views/pages/parts/slider-settings.php:1307
msgid "Smooth Height"
msgstr "Chiều Cao Mượt Mà"

#: admin/views/pages/parts/slider-settings.php:1312
msgid "Allow navigation to follow the slide's height smoothly."
msgstr "Cho phép điều hướng theo chiều cao của slide một cách mượt mà."

#: admin/views/pages/parts/slider-settings.php:1320
msgid "Slide Order"
msgstr "Thứ Tự Slide"

#: admin/views/pages/parts/slider-settings.php:1325
msgid "Newest First"
msgstr "Mới nhất trước"

#: admin/views/pages/parts/slider-settings.php:1328
msgid "Oldest First"
msgstr "Cũ nhất trước"

#: admin/views/pages/parts/slider-settings.php:1331
msgid "A to Z (by filename)"
msgstr "Từ A đến Z (theo tên tệp)"

#: admin/views/pages/parts/slider-settings.php:1334
msgid "Z to A (by filename)"
msgstr "Từ Z đến A (theo tên tệp)"

#: admin/views/pages/parts/slider-settings.php:1337
msgid "Drag-and-drop"
msgstr "Kéo và thả"

#: admin/views/pages/parts/slider-settings.php:1343
msgid ""
"Select the order in which slides appear in the slideshow. This impacts the "
"frontend view."
msgstr ""
"Chọn thứ tự mà các slide xuất hiện trong trình chiếu. Điều này ảnh hưởng "
"đến giao diện phía trước."

#: admin/views/pages/parts/slider-settings.php:1351
msgid "Touch Swipe"
msgstr "Vuốt chạm"

#: admin/views/pages/parts/slider-settings.php:1356
msgid "Allow touch swipe navigation of the slider on touch-enabled devices."
msgstr ""
"Cho phép điều hướng vuốt chạm của thanh trượt trên các thiết bị hỗ trợ cảm "
"ứng."

#: admin/views/pages/parts/slider-settings.php:1364
msgid "Loading Indicator"
msgstr "Chỉ báo đang tải"

#: admin/views/pages/parts/slider-settings.php:1369
msgid "Displays a visual indicator while the slideshow is loading."
msgstr "Hiển thị một chỉ báo hình ảnh trong khi trình chiếu đang tải."

#: admin/views/pages/parts/slider-settings.php:1377
msgid "Previous Text"
msgstr "Văn bản trước"

#: admin/views/pages/parts/slider-settings.php:1379
msgid "Set the text for the \"previous\" direction item."
msgstr "Đặt văn bản cho mục hướng \"trước\"."

#: admin/views/pages/parts/slider-settings.php:1391
msgid "Next Text"
msgstr "Văn bản tiếp theo"

#: admin/views/pages/parts/slider-settings.php:1393
msgid "Set the text for the \"next\" direction item."
msgstr "Đặt văn bản cho mục hướng \"tiếp theo\"."

#: admin/views/pages/parts/slider-settings.php:1410
msgid "Square Delay"
msgstr "Thời gian trễ hình vuông"

#: admin/views/pages/parts/slider-settings.php:1412
msgid "Delay between squares in ms."
msgstr "Thời gian trễ giữa các hình vuông tính bằng ms."

#: admin/views/pages/parts/slider-settings.php:1429
msgid "Opacity of title and navigation, between 0 and 1."
msgstr "Độ mờ của tiêu đề và điều hướng, trong khoảng từ 0 đến 1."

#: admin/views/pages/parts/slider-settings.php:1444
msgid "Caption Speed"
msgstr "Tốc độ chú thích"

