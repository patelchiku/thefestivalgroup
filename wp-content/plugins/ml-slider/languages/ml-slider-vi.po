#: themes/manifest-legacy.php:210
#: themes/manifest.php:210
msgid "Cascade is a minimalist theme ideal for vertical sliding."
msgstr "Cascade là một chủ đề tối giản lý tưởng cho việc trượt dọc."

#: themes/manifest-legacy.php:218
msgid ""
"The Nivo Light theme included here for legacy purposes. Note: only works "
